# Copy to server/.env (git-ignored) and fill in. Keys stay on this server; the phone never sees them.
#
# AI_PROVIDER picks the brain explicitly. There is no automatic fallback between providers:
#   offline      - rule-based intents only (default when unset)
#   anthropic    - Claude via ANTHROPIC_API_KEY
#   azure_openai - Azure OpenAI / Microsoft Foundry deployment (settings below)
AI_PROVIDER=offline

# ---- Anthropic ---------------------------------------------------------------
# console.anthropic.com > Settings > API keys
ANTHROPIC_API_KEY=<anthropic-api-key>
# JARVIS_MODEL=claude-opus-5-5

# ---- Azure OpenAI / Microsoft Foundry ----------------------------------------
# AZURE_OPENAI_ENDPOINT - one of:
#   a) Azure OpenAI endpoint: https://<resource>.openai.azure.com/
#      Azure portal > your Azure OpenAI (or Foundry/AI Services) resource > Resource Management > Keys and Endpoint
#      (Foundry portal: ai.azure.com > your project > Overview > "Azure OpenAI" endpoint)
#      -> needs AZURE_OPENAI_API_VERSION.
#   b) OpenAI v1 endpoint: https://<resource>.openai.azure.com/openai/v1/
#      (or https://<resource>.services.ai.azure.com/openai/v1/) -> API version not used.
#   c) A deployment's Target URI pasted as-is (Foundry > Models + endpoints > your deployment > Target URI);
#      deployment name and api-version are read from it and must match the values below if you also set them.
#   Not supported: Foundry project endpoints (.../api/projects/...) and model-inference endpoints (.../models).
AZURE_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com/>
# Same page as the endpoint: "KEY 1" or "KEY 2" (Foundry: deployment details > Key).
AZURE_OPENAI_API_KEY=<azure-openai-key>
# The *deployment* name you chose (Foundry > Models + endpoints > Name column), not the model name.
# The model must support JSON-schema structured outputs (e.g. gpt-4o 2024-08-06 or newer, gpt-4.1, gpt-4o-mini).
AZURE_OPENAI_DEPLOYMENT_NAME=<deployment-name>
# Data-plane API version, e.g. 2024-10-21 (GA) or a newer preview; shown as ?api-version= in the Target URI.
# Must be 2024-08-01-preview or later for structured outputs. Leave empty for the /openai/v1/ endpoint.
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Microsoft 365: Outlook mail + calendar (Microsoft Graph, optional) ---------
# Entra app registration "Application (client) ID" (see README > Microsoft 365). No client secret is used.
MS_GRAPH_CLIENT_ID=<application-client-id>
# common = work/school + personal accounts; consumers = personal only; organizations; or your tenant id.
MS_GRAPH_TENANT=common
# Windows time zone name used for calendar events.
JARVIS_TIMEZONE=India Standard Time
# Long random passphrase that encrypts stored OAuth tokens. Changing it later means reconnecting.
JARVIS_SECRET_KEY=<long-random-passphrase>

# ---- WhatsApp Business Platform (optional) -------------------------------------
# Sends from a registered WhatsApp *Business* number only (never your personal chats). Without these,
# JARVIS uses the phone's WhatsApp hand-off / share sheet. See README > WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=<system-user-permanent-access-token>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
WHATSAPP_API_VERSION=v21.0

# ---- Azure AI Speech (optional; the phone's own speech works without it) ------
# Azure portal > your Speech resource > Keys and Endpoint: KEY 1 and Location/Region (e.g. centralindia).
AZURE_SPEECH_KEY=<speech-resource-key>
AZURE_SPEECH_REGION=<region-e.g.-centralindia>
AZURE_SPEECH_VOICE=en-GB-RyanNeural
AZURE_SPEECH_LANGUAGE=en-IN

# ---- Storage: MongoDB Atlas (optional) ---------------------------------------
# Unset/placeholder = local JSON files in server/data/ (single process, this machine only, no backup).
# Set = Atlas only. If Atlas is unreachable the server refuses actions; it never falls back to local files.
# Atlas: Database > Connect > Drivers > Python: copy the mongodb+srv:// string and put the database user's
# password in it (URL-encode special characters). Also add this machine's IP under Security > Network Access.
MONGODB_URI=<mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority>
# Database to use inside the cluster (created on first write).
MONGODB_DB_NAME=jarvis

# JARVIS_PORT=8000
